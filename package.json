{
  "name": "pdf2audio",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Petar Sabev",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @pdf2audio/server dev",
    "dev:web": "pnpm --filter @pdf2audio/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @pdf2audio/server db:generate",
    "db:migrate": "pnpm --filter @pdf2audio/server db:migrate",
    "e2e:smoke": "pnpm --filter @pdf2audio/e2e smoke",
    "e2e:full": "pnpm --filter @pdf2audio/e2e full",
    "e2e:ui": "pnpm --filter @pdf2audio/e2e ui",
    "setup": "bash scripts/setup.sh",
    "jobs": "bash scripts/jobs.sh",
    "jobs:clear": "source .env 2>/dev/null; psql \"$DATABASE_URL\" -c 'DELETE FROM graphile_worker._private_jobs; SELECT count(*) AS remaining FROM graphile_worker._private_jobs;'",
    "app": "bash scripts/desktop-build.sh --fast --install",
    "app:dmg": "bash scripts/desktop-build.sh",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "defuddle": "^0.19.2",
    "linkedom": "^0.18.13"
  }
}
