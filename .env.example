DATABASE_URL=postgres://pdf2audio:pdf2audio@localhost:5433/pdf2audio
DATA_DIR=./data
PORT=3034
# Python env bin dir — scripts/setup.sh appends the real value (defaults to <repo>/.venv/bin)
# CONDA_ENV_PATH=
DEEPSEEK_API_KEY=
# Optional: Cartesia cloud TTS (`cartesia:` voices). Without it the Cartesia tab in the voice picker stays empty.
CARTESIA_API_KEY=
# Optional, setup-time only: HuggingFace token for Pocket TTS voice cloning.
# The 26 built-in Pocket TTS voices need no token. Cloning weights are gated — accept the
# terms at https://huggingface.co/kyutai/pocket-tts, then re-run `pnpm run setup`.
# HF_TOKEN=
# Optional: copy finished synced-EPUB exports here (Storyteller watch folder)
# READALOUD_DROP_DIR=/absolute/path/to/storyteller/data/import
