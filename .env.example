DATABASE_URL=postgres://pdf2audio:pdf2audio@localhost:5433/pdf2audio
DATA_DIR=./data
PORT=3034
# Python env bin dir — scripts/setup.sh appends the real value (defaults to <repo>/.venv/bin)
# CONDA_ENV_PATH=
# AI cloud providers — set any; each configured provider's models show up in the in-app pickers.
# Local models need NO configuration: Ollama and LM Studio servers are auto-discovered,
# and every installed chat model appears in the pickers automatically (fully offline AI).
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Custom OpenAI-compatible server (mlx_lm.server, llama.cpp, a remote box) — only needed
# when it is not Ollama/LM Studio on the default ports.
# LOCAL_LLM_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=my-model
# LOCAL_LLM_LABEL=Local (my-model)
# LOCAL_LLM_CONTEXT_TOKENS=32768
# Set false if the custom local model can't do tool calling (disables it for library chat only)
# LOCAL_LLM_TOOLS=true
# Optional: Cartesia cloud TTS (`cartesia:` voices). Without it the Cartesia tab in the voice picker stays empty.
CARTESIA_API_KEY=
# Optional, setup-time only: HuggingFace token for Pocket TTS voice cloning.
# The 26 built-in Pocket TTS voices need no token. Cloning weights are gated — accept the
# terms at https://huggingface.co/kyutai/pocket-tts, then re-run `pnpm run setup`.
# HF_TOKEN=
# Optional: copy finished synced-EPUB exports here (Storyteller watch folder)
# READALOUD_DROP_DIR=/absolute/path/to/storyteller/data/import
