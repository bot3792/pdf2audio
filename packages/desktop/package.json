{
  "name": "@pdf2audio/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "start": "electron .",
    "pack": "electron-builder --mac --dir",
    "dmg": "electron-builder --mac",
    "bundle:tools": "python3 ../../scripts/bundle-tools.py",
    "icon": "bash ../../scripts/make-icon.sh",
    "app": "bash ../../scripts/desktop-build.sh --fast --install",
    "app:dmg": "bash ../../scripts/desktop-build.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "main": "src/main.cjs",
  "build": {
    "appId": "dev.pdf2audio.app",
    "productName": "pdf2audio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "../../scripts",
        "to": "scripts"
      },
      {
        "from": "../server/drizzle",
        "to": "drizzle"
      },
      {
        "from": "../../pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "../../uv.lock",
        "to": "uv.lock"
      },
      {
        "from": "../../docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "dmg": {
      "icon": "build/icon.icns"
    }
  }
}
